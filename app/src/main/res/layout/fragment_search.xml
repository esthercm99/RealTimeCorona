<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="20dp"
    android:layout_marginRight="20dp"
    android:paddingTop="10dp">

    <EditText
        android:id="@+id/search"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:ems="20"
        android:hint="Search country..."
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/iconSearch"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iconSearch"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_search_black_24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>

    <TextView
        android:id="@+id/txtNotFound"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="24sp"
        android:textAlignment="center"
        android:text="Country not found"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/search"
        android:visibility="invisible"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/infoCountry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        app:layout_constraintTop_toBottomOf="@id/search">
        <ImageView
            android:id="@+id/imgCountry"
            android:layout_width="250dp"
            android:layout_height="150dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:contentDescription="@string/world" />

        <TextView
            android:id="@+id/nameCountry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            android:textAlignment="center"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/imgCountry" />

        <TextView
            android:id="@+id/lblTotalCases"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total Cases"
            android:textSize="24sp"
            android:textStyle="italic"
            android:textAlignment="center"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/nameCountry"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent" />
        <TextView
            android:id="@+id/txtTotalCases"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textSize="28sp"
            app:layout_constraintTop_toBottomOf="@id/lblTotalCases"/>


        <TextView
            android:id="@+id/lblActualCases"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Actual Cases"
            android:textSize="24sp"
            android:textStyle="italic"
            android:textAlignment="center"
            app:layout_constraintTop_toBottomOf="@id/txtTotalCases"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent" />
        <TextView
            android:id="@+id/txtActualCases"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textSize="28sp"
            app:layout_constraintTop_toBottomOf="@id/lblActualCases"/>

        <TextView
            android:id="@+id/lblRecovered"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recovered"
            android:textSize="24sp"
            android:textStyle="italic"
            android:textAlignment="center"
            app:layout_constraintTop_toBottomOf="@id/txtActualCases"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent" />
        <TextView
            android:id="@+id/txtRecovered"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textSize="28sp"
            app:layout_constraintTop_toBottomOf="@id/lblRecovered"/>

        <TextView
            android:id="@+id/lblDeaths"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Deaths"
            android:textSize="24sp"
            android:textStyle="italic"
            android:textAlignment="center"
            app:layout_constraintTop_toBottomOf="@id/txtRecovered"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent" />
        <TextView
            android:id="@+id/txtDeaths"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textSize="28sp"
            app:layout_constraintTop_toBottomOf="@id/lblDeaths"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>