<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:paddingTop="?attr/actionBarSize">

    <ImageView
        android:id="@+id/imgWorld"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/world"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:contentDescription="@string/world" />

    <TextView
        android:id="@+id/lblTotalCases"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total Cases"
        android:textSize="24sp"
        android:textStyle="italic"
        android:textAlignment="center"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/imgWorld"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />
    <TextView
        android:id="@+id/txtTotalCases"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0"
        android:textStyle="bold"
        android:textAlignment="center"
        android:textSize="28sp"
        app:layout_constraintTop_toBottomOf="@id/lblTotalCases"/>


    <TextView
        android:id="@+id/lblActualCases"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Actual Cases"
        android:textSize="24sp"
        android:textStyle="italic"
        android:textAlignment="center"
        app:layout_constraintTop_toBottomOf="@id/txtTotalCases"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />
    <TextView
        android:id="@+id/txtActualCases"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0"
        android:textStyle="bold"
        android:textAlignment="center"
        android:textSize="28sp"
        app:layout_constraintTop_toBottomOf="@id/lblActualCases"/>

    <TextView
        android:id="@+id/lblRecovered"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recovered"
        android:textSize="24sp"
        android:textStyle="italic"
        android:textAlignment="center"
        app:layout_constraintTop_toBottomOf="@id/txtActualCases"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />
    <TextView
        android:id="@+id/txtRecovered"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0"
        android:textStyle="bold"
        android:textAlignment="center"
        android:textSize="28sp"
        app:layout_constraintTop_toBottomOf="@id/lblRecovered"/>

    <TextView
        android:id="@+id/lblDeaths"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Deaths"
        android:textSize="24sp"
        android:textStyle="italic"
        android:textAlignment="center"
        app:layout_constraintTop_toBottomOf="@id/txtRecovered"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />
    <TextView
        android:id="@+id/txtDeaths"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0"
        android:textStyle="bold"
        android:textAlignment="center"
        android:textSize="28sp"
        app:layout_constraintTop_toBottomOf="@id/lblDeaths"/>

</androidx.constraintlayout.widget.ConstraintLayout>